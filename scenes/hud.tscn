[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_script"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Root" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 22

[node name="Bar" type="HBoxContainer" parent="Root"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 24

[node name="Score" type="VBoxContainer" parent="Root/Bar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Row" type="HBoxContainer" parent="Root/Bar/Score"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Root/Bar/Score/Row"]
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.97, 1, 1)
theme_override_colors/font_outline_color = Color(0.06, 0.09, 0.13, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 26
text = "PUNTOS"

[node name="Value" type="Label" parent="Root/Bar/Score/Row"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.45, 1)
theme_override_colors/font_outline_color = Color(0.06, 0.09, 0.13, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 32
text = "0"

[node name="Combo" type="Label" parent="Root/Bar/Score"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.62, 0.35, 1)
theme_override_colors/font_outline_color = Color(0.12, 0.06, 0.03, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 20
text = ""

[node name="Fill" type="VBoxContainer" parent="Root/Bar"]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 0
theme_override_constants/separation = 4

[node name="Row" type="HBoxContainer" parent="Root/Bar/Fill"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/Bar/Fill/Row"]
layout_mode = 2
